root = true

[*]
indent_style = space
indent_size = 4

charset = utf-8
max_line_length = 160
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml}]
indent_size = 2

# serialized PHP payloads: a trailing newline makes unserialize() warn since PHP 8.3
[tests/Resources/**/buddy-works/repman.json]
insert_final_newline = false
